---
layout: layouts/base.njk
title: Attendee Portal
permalink: /attendees/index.html
description: Fall 2026 Fight for Manhood attendee schedule and weekly resources.
---
<div class="page-shell">
  <div class="container">
    <header class="portal-hero">
      <span class="eyebrow">{{ site.name }} Ã‚Â· {{ site.cohort.name }}</span>
      <h1>Attendee Portal</h1>
      <p class="section-lead">Weekly dates, curriculum focus, session notes, Scripture pages, teaching videos, and slide decks.</p>
    </header>

    <section class="portal-update" aria-labelledby="attendee-update-heading">
      <h2 id="attendee-update-heading">Fall 2026 begins Tuesday, September 15</h2>
      <p>We meet every Tuesday at {{ site.cohort.time }} through November 17 at {{ site.cohort.venue }}. Existing resources remain available below; updated Fall materials will replace them as each session is finalized.</p>
    </section>

    <section class="section" aria-labelledby="weekly-resources-heading">
      <h2 class="section-title" id="weekly-resources-heading">Weekly resources</h2>
      <div class="portal-grid">
        {% for item in curriculum %}
          {% set resource = resources[loop.index0] %}
          <article class="portal-card">
            <div class="week-label">Week {{ item.week }} Ã‚Â· {{ item.date | isoDate }}</div>
            <h3>{{ item.title }}</h3>
            <p>{{ item.summary }}</p>
            <div class="resource-links">
              {% if resource.notes %}<a class="button small primary" href="{{ resource.notes }}" target="_blank" rel="noopener">Session notes</a>{% endif %}
              {% if resource.scripture %}<a class="button small" href="{{ resource.scripture }}" target="_blank" rel="noopener">Scripture page</a>{% endif %}
              {% if resource.video %}<a class="button small" href="{{ resource.video }}" target="_blank" rel="noopener">Teaching video</a>{% endif %}
              {% if resource.slides %}<a class="button small" href="{{ resource.slides }}" target="_blank" rel="noopener">Slide deck</a>{% endif %}
              {% if not resource.notes and not resource.scripture and not resource.video and not resource.slides %}<span class="status">Materials will be posted before this session</span>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </section>

    <section class="section" aria-labelledby="groups-heading">
      <h2 class="section-title" id="groups-heading">Small groups</h2>
      <p class="section-lead">Fall 2026 group assignments and private communication links will be sent directly to registered attendees. Public placeholder links have been removed.</p>
    </section>
  </div>
</div>

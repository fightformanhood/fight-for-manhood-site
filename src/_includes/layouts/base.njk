<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description or site.program.description }}">
    <meta name="theme-color" content="#070b12">
    <title>{{ title }}{% if title != site.name %} | {{ site.name }}{% endif %}</title>
    <link rel="canonical" href="https://fightformanhood.com{{ page.url }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ title }}{% if title != site.name %} | {{ site.name }}{% endif %}">
    <meta property="og:description" content="{{ description or site.program.description }}">
    <meta property="og:url" content="https://fightformanhood.com{{ page.url }}">
    <meta name="twitter:card" content="summary">
    <link rel="stylesheet" href="/assets/css/site.css">
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Fight for Manhood home">Fight for Manhood</a>
      <nav aria-label="Primary navigation">
        {% for item in site.navigation %}
          <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endfor %}
      </nav>
    </header>

    <main id="main-content">{{ content | safe }}</main>

    <footer class="site-footer">
      <strong>{{ site.name }}</strong>
      <span>{{ site.tagline }}</span>
      <span>A biblical formation experience for men &middot; Cohorts and communities</span>
      <span>Presented by <a href="https://fightlikeamanministries.com/" rel="noopener">Fight Like a Man Ministries</a></span>
      <span>&copy; {{ site.year }} {{ site.name }}</span>
    </footer>
  </body>
</html>

